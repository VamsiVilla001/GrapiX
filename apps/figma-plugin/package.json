{
  "name": "@grapix/figma-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es2017 --format=iife && node scripts/copy-ui.mjs",
    "watch": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es2017 --format=iife --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.4"
  }
}
