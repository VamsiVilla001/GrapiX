{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GrapiX",
  "version": "0.1.0",
  "identifier": "com.grapix.editor",
  "build": {
    "frontendDist": "../../editor-web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../.. run dev:web",
    "beforeBuildCommand": "npm --prefix ../.. run build -w @grapix/editor-web"
  },
  "app": {
    "windows": [
      {
        "title": "GrapiX",
        "width": 1600,
        "height": 950,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/grapix-render-daemon"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
