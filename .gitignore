# --- Dependencies and build output ------------------------------------------
node_modules/
dist/
# The publishable CLI bundle for @grapix/editor-mcp. Build output (esbuild), not source.
bundle/
.vite/
*.tsbuildinfo
coverage/

# Cargo build caches. One per crate: services/*, and each src-tauri.
target/

# Tauri generated schemas and permission files. They embed absolute paths, so a
# stale copy fails a build naming a path that no longer exists.
gen/

# Sidecar binaries staged into a bundle by build.rs. Build output, not source —
# and a stale one is how a retired binary gets shipped.
binaries/

# --- Local configuration and secrets ----------------------------------------
*.local
.env
.env.*
.claude/settings.local.json

# --- Runtime state ----------------------------------------------------------
# Scenes, assets, published packages, rundowns, caches, tokens and operator
# logs. Written by the running system, never source. Real user content lives
# here, so it is ignored rather than deleted by tooling.
data/
cache/

# --- Agent and harness scratch ----------------------------------------------
.claude/worktrees/
.codex-run/
.codex/
*.log
*.err.log

# --- Run evidence -----------------------------------------------------------
# Pixel-parity captures and diff images: evidence from a run, not source.
artifacts/

# --- Vendored third-party SDKs ----------------------------------------------
# Adobe's After Effects SDK and Photoshop API SDK, fetched locally for reference.
# Both carry Adobe licence terms and are not redistributable from this repository.
# What GrapiX depends on is transcribed into Shared/adobe-common-schema with the
# header and line each value came from; nothing in the build reads this directory.
vendor/adobe/
