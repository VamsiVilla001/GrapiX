# Rust
/target/
**/*.rs.bk

# Node
node_modules/
dist/
build/
*.tsbuildinfo

# Tauri
**/src-tauri/target/
# Tauri 2 writes generated capability schemas beside the shell crate.
Editor/shell/gen/
Playout/shell/gen/

# The Editor's web bundle is built from web/main.ts by esbuild. The source is
# committed; the bundle and its map are not.
Editor/web/main.js
Editor/web/main.js.map

# Local
.env
.env.local
.DS_Store
*.log

# One shared agent worktree; private settings and local preservation data.
/agent/worktree/
/agent/archive/
/agent/tmp/
/agent/reference/
/agent/config/claude.local.json
/agent/config/claude-launch.json

# Prevent provider-generated workspaces and temporary captures returning.
/.claude/
/.codex/
/.omp/
.tmp*
*.tmp

# Third-party source checkouts kept for study (e.g. reference/effectcraft).
# Anything taken from them is copied into the tree with attribution; the
# checkouts themselves are never committed or built as part of GrapiX.
reference/

# ts-rs per-crate export dirs; the codegen binary is the only generator
bindings/
target/release/bundle/
