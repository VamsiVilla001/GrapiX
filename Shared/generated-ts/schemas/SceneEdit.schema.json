{
  "$comment": "GENERATED by gx-contract-codegen from gx-contracts::command. Do not edit (invariant 23).",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grapix:schema:SceneEdit",
  "title": "SceneEdit",
  "$defs": {
    "ApplyPreset": {
      "description": "Instantiate one phase of a starter motion preset at `atFrame`.",
      "properties": {
        "atFrame": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "objectId": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/PresetPhase"
        },
        "presetId": {
          "type": "string"
        }
      },
      "required": [
        "objectId",
        "presetId",
        "phase",
        "atFrame"
      ],
      "type": "object"
    },
    "ApplyTextStyle": {
      "properties": {
        "objectId": {
          "type": "string"
        },
        "styleId": {
          "type": "string"
        }
      },
      "required": [
        "objectId",
        "styleId"
      ],
      "type": "object"
    },
    "ColorValue": {
      "description": "An authored paint: nothing, a colour, or a gradient.\n\n`None` is a value, not an absence — \"the author turned the fill off\" and\n\"the author has not set a fill\" are different states, and collapsing them\nis how a transparent object becomes a black one on the other renderer.\nPorted from 1.x `ColorValue`, with every colour now tagged.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "color": {
              "$ref": "#/$defs/Rgba"
            },
            "type": {
              "const": "solid",
              "type": "string"
            }
          },
          "required": [
            "type",
            "color"
          ],
          "type": "object"
        },
        {
          "properties": {
            "angle": {
              "description": "Degrees, clockwise from the positive X axis.",
              "format": "double",
              "type": "number"
            },
            "coordinateMode": {
              "$ref": "#/$defs/GradientCoordinateMode",
              "default": "object"
            },
            "endX": {
              "format": "double",
              "type": "number"
            },
            "endY": {
              "format": "double",
              "type": "number"
            },
            "spread": {
              "$ref": "#/$defs/GradientSpread",
              "default": "pad"
            },
            "startX": {
              "format": "double",
              "type": "number"
            },
            "startY": {
              "format": "double",
              "type": "number"
            },
            "stops": {
              "items": {
                "$ref": "#/$defs/GradientStop"
              },
              "type": "array"
            },
            "type": {
              "const": "linear-gradient",
              "type": "string"
            }
          },
          "required": [
            "type",
            "angle",
            "startX",
            "startY",
            "endX",
            "endY",
            "stops"
          ],
          "type": "object"
        },
        {
          "properties": {
            "centerX": {
              "format": "double",
              "type": "number"
            },
            "centerY": {
              "format": "double",
              "type": "number"
            },
            "coordinateMode": {
              "$ref": "#/$defs/GradientCoordinateMode",
              "default": "object"
            },
            "focalX": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "focalY": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "radiusX": {
              "format": "double",
              "type": "number"
            },
            "radiusY": {
              "format": "double",
              "type": "number"
            },
            "spread": {
              "$ref": "#/$defs/GradientSpread",
              "default": "pad"
            },
            "stops": {
              "items": {
                "$ref": "#/$defs/GradientStop"
              },
              "type": "array"
            },
            "type": {
              "const": "radial-gradient",
              "type": "string"
            }
          },
          "required": [
            "type",
            "centerX",
            "centerY",
            "radiusX",
            "radiusY",
            "stops"
          ],
          "type": "object"
        }
      ]
    },
    "ContentHash": {
      "description": "Content address of asset bytes: SHA-256, lowercase hex.",
      "type": "string"
    },
    "ControlField": {
      "description": "One named property an operator is allowed to fill on a template.",
      "properties": {
        "default": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "fieldId": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ControlFieldKind"
        },
        "label": {
          "type": "string"
        },
        "objectId": {
          "type": "string"
        },
        "property": {
          "type": "string"
        }
      },
      "required": [
        "fieldId",
        "label",
        "objectId",
        "property",
        "kind"
      ],
      "type": "object"
    },
    "ControlFieldKind": {
      "description": "The kind of value an operator may enter for a declared field.",
      "enum": [
        "text",
        "number",
        "color",
        "boolean",
        "asset"
      ],
      "type": "string"
    },
    "ControlValue": {
      "description": "A typed value supplied to a declared control field.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "number",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "color",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ColorValue"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "boolean",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "asset",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "CreateKeyframe": {
      "properties": {
        "keyframe": {
          "$ref": "#/$defs/SceneKeyframe"
        },
        "objectId": {
          "type": "string"
        },
        "property": {
          "type": "string"
        }
      },
      "required": [
        "objectId",
        "property",
        "keyframe"
      ],
      "type": "object"
    },
    "CreateObject": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "CubicBezier": {
      "description": "Cubic-bezier control points for a custom outgoing easing.\n\n`x1` and `x2` stay in 0–1 because they are time controls; y may overshoot,\nas CSS and standard animation tooling allow. The points are stored with the\nkey, not solved from neighbouring keys at display time, so a saved scene\nmeans the same curve when it is reopened.",
      "properties": {
        "x1": {
          "format": "double",
          "type": "number"
        },
        "x2": {
          "format": "double",
          "type": "number"
        },
        "y1": {
          "format": "double",
          "type": "number"
        },
        "y2": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "type": "object"
    },
    "DeclareControl": {
      "properties": {
        "field": {
          "$ref": "#/$defs/ControlField"
        }
      },
      "required": [
        "field"
      ],
      "type": "object"
    },
    "DeleteMaterial": {
      "properties": {
        "materialId": {
          "type": "string"
        }
      },
      "required": [
        "materialId"
      ],
      "type": "object"
    },
    "DeleteObject": {
      "properties": {
        "objectId": {
          "type": "string"
        }
      },
      "required": [
        "objectId"
      ],
      "type": "object"
    },
    "DuplicateObject": {
      "properties": {
        "objectId": {
          "type": "string"
        }
      },
      "required": [
        "objectId"
      ],
      "type": "object"
    },
    "EditProperty": {
      "description": "A property value edit; with `autoKey` it also upserts a key at `frame`.",
      "properties": {
        "autoKey": {
          "type": "boolean"
        },
        "frame": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "objectId": {
          "type": "string"
        },
        "property": {
          "type": "string"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "objectId",
        "property",
        "value",
        "frame",
        "autoKey"
      ],
      "type": "object"
    },
    "GradientCoordinateMode": {
      "description": "Whether a gradient's coordinates are the object's or the scene's. An\nobject-space gradient follows its object; a scene-space one stays put\nwhile the object moves through it.",
      "enum": [
        "object",
        "scene"
      ],
      "type": "string"
    },
    "GradientSpread": {
      "description": "What a gradient does outside its 0–1 span. CSS's own names.",
      "enum": [
        "pad",
        "repeat",
        "reflect"
      ],
      "type": "string"
    },
    "GradientStop": {
      "description": "One stop of a gradient.",
      "properties": {
        "color": {
          "$ref": "#/$defs/Rgba"
        },
        "position": {
          "description": "0–1 along the gradient.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "position",
        "color"
      ],
      "type": "object"
    },
    "MoveKeyframe": {
      "properties": {
        "fromFrame": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "objectId": {
          "type": "string"
        },
        "property": {
          "type": "string"
        },
        "toFrame": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "objectId",
        "property",
        "fromFrame",
        "toFrame"
      ],
      "type": "object"
    },
    "ObjectField": {
      "description": "A typed inspector field/value pair. The adjacent tag makes an invalid field\nand value combination unrepresentable on the command wire.",
      "oneOf": [
        {
          "properties": {
            "name": {
              "const": "opacity",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "x",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "y",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "rotation",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "scaleX",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "scaleY",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "fontId",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "size",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "radius",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "PhaseKind": {
      "description": "The operator phases a scene timeline can name.\n\nThese are exactly `crate::mcp::MOTION_PHASES`, and a test below pins them\nagainst it: a phase added to one and not the other fails the gate rather\nthan producing a scene the agent surface cannot describe.",
      "oneOf": [
        {
          "const": "in",
          "description": "Build on. Triggered by Take.",
          "type": "string"
        },
        {
          "const": "hold",
          "description": "Idle loop after `in` completes. Interruptible at any frame.",
          "type": "string"
        },
        {
          "const": "out",
          "description": "Build off. Triggered by Out.",
          "type": "string"
        },
        {
          "const": "continue",
          "description": "A staged build, triggered by Continue. A timeline may carry several.",
          "type": "string"
        },
        {
          "const": "update",
          "description": "How a bound value changes on air without a full re-take.",
          "type": "string"
        }
      ]
    },
    "PresetPhase": {
      "description": "Which preset phase `ApplyPreset` instantiates.",
      "enum": [
        "in",
        "out"
      ],
      "type": "string"
    },
    "RelinkAsset": {
      "description": "Point a library asset at new bytes, keeping its id and bindings.",
      "properties": {
        "assetId": {
          "type": "string"
        },
        "newHash": {
          "$ref": "#/$defs/ContentHash"
        },
        "newSize": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "assetId",
        "newHash"
      ],
      "type": "object"
    },
    "RelinkMaterial": {
      "description": "Repoint every use of one material to another.",
      "properties": {
        "fromMaterialId": {
          "type": "string"
        },
        "toMaterialId": {
          "type": "string"
        }
      },
      "required": [
        "fromMaterialId",
        "toMaterialId"
      ],
      "type": "object"
    },
    "RemoveControl": {
      "properties": {
        "fieldId": {
          "type": "string"
        }
      },
      "required": [
        "fieldId"
      ],
      "type": "object"
    },
    "RemoveKeyframe": {
      "properties": {
        "frame": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "objectId": {
          "type": "string"
        },
        "property": {
          "type": "string"
        }
      },
      "required": [
        "objectId",
        "property",
        "frame"
      ],
      "type": "object"
    },
    "RemovePhase": {
      "properties": {
        "address": {
          "type": "string"
        }
      },
      "required": [
        "address"
      ],
      "type": "object"
    },
    "RenameObject": {
      "properties": {
        "name": {
          "type": "string"
        },
        "objectId": {
          "type": "string"
        }
      },
      "required": [
        "objectId",
        "name"
      ],
      "type": "object"
    },
    "ReplaceControl": {
      "description": "Replace the declared control with the same `fieldId`.",
      "properties": {
        "field": {
          "$ref": "#/$defs/ControlField"
        }
      },
      "required": [
        "field"
      ],
      "type": "object"
    },
    "ReplaceDataContext": {
      "properties": {
        "dataContext": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "dataContext"
      ],
      "type": "object"
    },
    "Rgba": {
      "description": "A colour, with the space it was authored in.\n\nComponents are 0–1 floats rather than 8-bit bytes because the working\nspace is linear and 8 bits of linear has visible banding in the shadows.",
      "properties": {
        "a": {
          "description": "Straight (non-premultiplied) alpha.",
          "format": "double",
          "type": "number"
        },
        "b": {
          "format": "double",
          "type": "number"
        },
        "g": {
          "format": "double",
          "type": "number"
        },
        "r": {
          "format": "double",
          "type": "number"
        },
        "space": {
          "$ref": "#/$defs/SourceColorSpace"
        }
      },
      "required": [
        "r",
        "g",
        "b",
        "a",
        "space"
      ],
      "type": "object"
    },
    "SaveTextStyle": {
      "properties": {
        "style": {
          "$ref": "#/$defs/TextStyle"
        }
      },
      "required": [
        "style"
      ],
      "type": "object"
    },
    "SceneEasing": {
      "description": "The easing between two keys. Closed and finite: the curve an author chooses\nmust be one every evaluator knows by name, because a substituted curve is a\nvisual change no one named (invariant 18).",
      "enum": [
        "linear",
        "hold",
        "ease-in",
        "ease-out",
        "ease-in-out",
        "custom-bezier"
      ],
      "type": "string"
    },
    "SceneKeyframe": {
      "description": "One key on one numeric property channel.",
      "properties": {
        "bezier": {
          "anyOf": [
            {
              "$ref": "#/$defs/CubicBezier"
            },
            {
              "type": "null"
            }
          ],
          "description": "Custom bezier control points, present exactly when easing is custom."
        },
        "easing": {
          "$ref": "#/$defs/SceneEasing",
          "default": "linear",
          "description": "Outgoing easing toward the next key."
        },
        "frame": {
          "description": "Absolute frame at the scene canvas rate.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "description": "The property's value at that frame, in the property's own units.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "frame",
        "value"
      ],
      "type": "object"
    },
    "SetBinding": {
      "description": "Bind `property` to a data path, or unbind it when `path` is absent.",
      "properties": {
        "objectId": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "property": {
          "type": "string"
        }
      },
      "required": [
        "objectId",
        "property"
      ],
      "type": "object"
    },
    "SetObjectField": {
      "description": "One inspector field over every listed object.",
      "properties": {
        "field": {
          "$ref": "#/$defs/ObjectField"
        },
        "objectIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "objectIds",
        "field"
      ],
      "type": "object"
    },
    "SetObjectLocked": {
      "properties": {
        "locked": {
          "type": "boolean"
        },
        "objectId": {
          "type": "string"
        }
      },
      "required": [
        "objectId",
        "locked"
      ],
      "type": "object"
    },
    "SetObjectVisible": {
      "properties": {
        "objectId": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "objectId",
        "visible"
      ],
      "type": "object"
    },
    "SetPhase": {
      "properties": {
        "phase": {
          "$ref": "#/$defs/TimelinePhase"
        }
      },
      "required": [
        "phase"
      ],
      "type": "object"
    },
    "SetSceneId": {
      "description": "Change the id of a scene that is not bound to a stored origin.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "SetSceneName": {
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "SourceColorSpace": {
      "description": "What a colour or a texture was authored in. There is no `Unknown`: an\nuntagged source is a defect the importer must refuse, not a value a\nrenderer may guess at (B.1, \"never infer\").",
      "oneOf": [
        {
          "enum": [
            "display-p3"
          ],
          "type": "string"
        },
        {
          "const": "srgb",
          "description": "IEC 61966-2-1. What a hex literal, a PNG without an ICC profile and\nmost authoring tools mean.",
          "type": "string"
        },
        {
          "const": "linear",
          "description": "Already linear — no decode on the way in.",
          "type": "string"
        },
        {
