          "type": "string"
        },
        {
          "const": "srgb",
          "description": "IEC 61966-2-1. What a hex literal, a PNG without an ICC profile and\nmost authoring tools mean.",
          "type": "string"
        },
        {
          "const": "linear",
          "description": "Already linear — no decode on the way in.",
          "type": "string"
        },
        {
          "const": "rec709",
          "description": "ITU-R BT.709 with its own transfer curve. Broadcast source material.",
          "type": "string"
        }
      ]
