      "enum": [
        "left",
        "center",
        "right"
      ],
      "type": "string"
    },
    "TextAutoFit": {
      "description": "What to do when shaped text does not fit its box. Never silently clipped.",
      "enum": [
        "none",
        "shrink",
        "fit"
      ],
      "type": "string"
    },
    "TextCase": {
      "description": "Case applied when the text is drawn, not when it is typed: the authored\ncharacters stay as they are, so a data binding can replace the text and\nthe case still applies, and switching it off returns the author's own\ncapitalisation.",
      "enum": [
        "original",
        "upper",
        "lower",
        "title",
        "small-caps"
      ],
      "type": "string"
    },
    "TextDecoration": {
      "description": "Underline and strikethrough: drawn from the font's metrics rather than\nshaped, so they are object state and not part of the font definition.",
      "properties": {
        "strikethrough": {
          "default": false,
          "type": "boolean"
        },
        "underline": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "TextLayout": {
      "description": "Point text grows from its origin; paragraph text wraps inside the base box.",
      "enum": [
        "point",
        "paragraph"
      ],
      "type": "string"
    },
