{
  "$comment": "GENERATED by gx-contract-codegen from gx-contracts::command. Do not edit (invariant 23).",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grapix:schema:edits:EditPath",
  "title": "EditPath",
  "$defs": {
    "HandleCoupling": {
      "description": "How the far handle follows (see [`Coupling`]), on the wire.",
      "enum": [
        "none",
        "smooth",
        "mirror"
      ],
      "type": "string"
    },
    "HandleSide": {
      "description": "Which handle of a vertex.",
      "enum": [
        "in",
        "out"
      ],
      "type": "string"
    },
    "PathOp": {
      "description": "One semantic change to one path. Each is exact and refuses by name what\nit cannot do; a whole gesture is one of these, so one undo step.",
      "oneOf": [
        {
          "description": "A vertex on `segment` at `t`, the curve unchanged (De Casteljau).",
          "properties": {
            "op": {
              "const": "insertVertex",
              "type": "string"
            },
            "segment": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "t": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "op",
            "segment",
            "t"
          ],
          "type": "object"
        },
        {
          "description": "Vertices taken out; the curves beside them join with their handles.",
          "properties": {
            "indices": {
              "items": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "op": {
              "const": "deleteVertices",
              "type": "string"
            }
          },
          "required": [
            "op",
            "indices"
          ],
          "type": "object"
        },
        {
          "description": "A corner made smooth, or a vertex with handles made a corner.",
          "properties": {
            "index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "convertVertex",
              "type": "string"
            }
          },
          "required": [
            "op",
            "index"
          ],
          "type": "object"
        },
        {
          "description": "A vertex taken out with one curve fitted over the two beside it, kept only when the shape stays within `tolerance` (11.113).",
          "properties": {
            "index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "deleteKeepShape",
              "type": "string"
            },
            "tolerance": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "op",
            "index",
            "tolerance"
          ],
          "type": "object"
        },
        {
          "description": "One handle set to `vector` (an offset from its vertex).",
          "properties": {
            "coupling": {
              "$ref": "#/$defs/HandleCoupling",
              "default": "none"
            },
            "index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "setHandle",
              "type": "string"
            },
            "side": {
              "$ref": "#/$defs/HandleSide"
            },
            "vector": {
              "$ref": "#/$defs/Vec2"
            }
          },
          "required": [
            "op",
            "index",
            "side",
            "vector"
          ],
          "type": "object"
        },
        {
          "description": "Vertices moved by `delta`, their handles with them.",
          "properties": {
            "delta": {
              "$ref": "#/$defs/Vec2"
            },
            "indices": {
              "items": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "op": {
              "const": "moveVertices",
              "type": "string"
            }
          },
          "required": [
            "op",
            "indices",
            "delta"
          ],
          "type": "object"
        },
        {
          "description": "The curve dragged at `t` of `segment` by `delta`; its ends stay.",
          "properties": {
            "delta": {
              "$ref": "#/$defs/Vec2"
            },
            "op": {
              "const": "reshapeSegment",
              "type": "string"
            },
            "segment": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "t": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "op",
            "segment",
            "t",
            "delta"
          ],
          "type": "object"
        },
        {
          "description": "The same outline drawn the other way.",
          "properties": {
            "op": {
              "const": "reverse",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "description": "A closed path started from vertex `index`.",
          "properties": {
            "index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "setFirstVertex",
              "type": "string"
            }
          },
          "required": [
            "op",
            "index"
          ],
          "type": "object"
        },
        {
          "description": "The path closed or opened.",
          "properties": {
            "closed": {
              "type": "boolean"
            },
            "op": {
              "const": "setClosed",
              "type": "string"
            }
          },
          "required": [
            "op",
            "closed"
          ],
          "type": "object"
        },
        {
          "description": "A vertex given a kind: corner, smooth, symmetric or auto (11.113).",
          "properties": {
            "index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "$ref": "#/$defs/VertexKind"
            },
            "op": {
              "const": "setVertexKind",
              "type": "string"
            }
          },
          "required": [
            "op",
            "index",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "The tension of the path's `auto` vertices, 0 to 1 (11.113).",
          "properties": {
            "op": {
              "const": "setAutoTension",
              "type": "string"
            },
            "tension": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "op",
            "tension"
          ],
          "type": "object"
        }
      ]
    },
    "PathTarget": {
      "description": "Which path of an object an `editPath` edit changes.",
      "oneOf": [
        {
          "description": "A shape's path: `subpath` 0 is its main path, 1 and on its compound\nsubpaths in order.",
          "properties": {
            "kind": {
              "const": "shape",
              "type": "string"
            },
            "subpath": {
              "default": 0,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "One of the object's masks, by its place in the list.",
          "properties": {
            "index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "mask",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "index"
          ],
          "type": "object"
        }
      ]
    },
    "Vec2": {
      "description": "A 2D point in scene coordinates.",
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "VertexKind": {
      "description": "How a path vertex's handles behave (11.113, pen spec v2 section 4).",
      "oneOf": [
        {
          "const": "corner",
          "description": "Handles move independently (or are absent).",
          "type": "string"
        },
        {
          "const": "smooth",
          "description": "Handles stay collinear and opposite; each keeps its own length.",
          "type": "string"
        },
        {
          "const": "symmetric",
          "description": "Handles stay collinear, opposite and of equal length.",
          "type": "string"
        },
        {
          "const": "auto",
          "description": "Handles are derived from the neighbours; stored ones are ignored.",
          "type": "string"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "One semantic operation on one path (11.107, the Pen spec's path\ncommands): insert, delete or convert vertices, set a handle, move\nvertices, reshape a segment, reverse, restart or close. `target`\nnames a shape's subpath or a mask; the result is checked as\n`setShapePath` or `setObjectMasks` checks it.",
  "properties": {
    "baseRevision": {
      "description": "For a path that is linked (11.112): the revision the edit was made on. The edit is refused when the\nshared path has been edited since.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "edit": {
      "const": "editPath"
    },
    "frame": {
      "description": "The frame an edit of an animated path is made at (11.112): a\nmove, handle or kind edit sets the key there; an edit of which\nvertices there are (insert, delete, reverse, first vertex,\nclose) lands in every key at once. Left out, the path is static.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "objectId": {
      "type": "string"
    },
    "op": {
      "$ref": "#/$defs/PathOp"
    },
    "target": {
      "$ref": "#/$defs/PathTarget"
    }
  },
  "required": [
    "objectId",
    "target",
    "op",
    "edit"
  ],
  "type": "object"
}
