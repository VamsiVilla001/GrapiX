  "additionalProperties": false,
  "description": "Ingest one Figma frame into a new stored scene (18.2, 18.3). The user's own agent\nreads the frame through Figma's MCP and passes the text of `get_metadata` as\n`metadata`; GrapiX holds no Figma token and makes no network call. The frame becomes\nthe canvas (its width and height), its nodes become objects at their Figma positions,\nand the report names everything `get_metadata` does not carry (fills, text content,\nfonts, radii, clipping). The metadata text is retained in the project by content\nhash. Refuses an existing id; one frame per call.",
  "properties": {
    "command": {
      "const": "importFigma"
    },
    "frame": {
      "anyOf": [
        {
          "$ref": "#/$defs/FigmaNode"
        },
        {
          "type": "null"
        }
      ],
      "description": "The full-fidelity route: the frame as the agent read it through Figma's MCP\n(fills, strokes, radii, text, fonts, blend modes), in the typed shape of\n[`FigmaNode`]. Exactly one of `frame` and `metadata` is given."
    },
    "imageFolder": {
      "description": "The folder under `Images` the frame's pictures are filed in; the root frame's\nname when absent. A picture fill's `image` is looked up there as `<image>.png`,\nthen `<image>.webp`.",
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "description": "The structure-only route: the reply of Figma's `get_metadata` for the frame,\nas received. Positions and nesting only, with no paint and no text.",
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "description": "The scene's display name; the Figma frame's name when absent.",
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "type": "string"
    },
    "sceneId": {
      "type": "string"
    },
    "sourceName": {
      "description": "What to call the retained source, for example the frame's name.",
      "type": "string"
    }
  },
  "required": [
    "project",
    "sceneId",
    "sourceName",
    "command"
  ],
  "type": "object"
