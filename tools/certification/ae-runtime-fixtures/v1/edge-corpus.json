    },
    {
      "id": "coloured-translucent-shadow",
      "composition": "BO0a-ColouredTranslucentShadow",
      "vector": "violet 62% opacity feathered shadow behind an opaque orange caster",
      "expect": { "opaque": "some", "transparent": "some", "partial": "some", "requireStraightDifference": true }
    },
    {
      "id": "premultiplied-black-edge",
      "composition": "BO0a-PremultipliedBlackEdge",
      "vector": "bright white through a narrow feathered mask on transparent black",
      "expect": { "opaque": "some", "transparent": "some", "partial": "some", "requireStraightDifference": true }
    }
