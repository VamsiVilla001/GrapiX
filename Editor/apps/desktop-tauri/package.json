{
  "name": "@grapix/desktop-tauri",
  "version": "0.1.0",
  "private": true,
  "description": "GrapiX desktop shell (Tauri 2 + WebView2).",
  "scripts": {
    "dev": "cargo build --manifest-path ../../../services/render-daemon/Cargo.toml --no-default-features && tauri dev",
    "build": "cargo build --release --manifest-path ../../../services/render-daemon/Cargo.toml --no-default-features && tauri build",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  }
}
