{
  "$schema": "../../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GrapiX",
  "version": "0.1.0",
  "identifier": "com.grapix.editor",
  "build": {
    "frontendDist": "../../editor-web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../.. run dev:web",
    "beforeBuildCommand": "npm --prefix ../../.. run build -w @grapix/editor-web"
  },
  "app": {
    "windows": [
      {
        "title": "GrapiX",
        "width": 1600,
        "height": 950,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/grapix-render-engine",
      "binaries/node"
    ],
    "resources": {
      "../../../../Editor/services/project-api/dist/bundle/grapix-api-server.mjs": "services/grapix-api-server.mjs",
      "../../../../Editor/services/editor-assistant/dist/bundle/grapix-editor-assistant.mjs": "services/grapix-editor-assistant.mjs",
      "../../../../Editor/services/adobe-mcp-gateway/dist/bundle/grapix-adobe-mcp-gateway.mjs": "services/grapix-adobe-mcp-gateway.mjs",
      "../../../../Editor/services/editor-mcp/dist/bundle/grapix-editor-mcp.mjs": "services/grapix-editor-mcp.mjs",
      "../../../../Editor/services/editor-mcp/dist/knowledge-root/": "knowledge/",
      "../../../../Editor/services/project-api/dist/bundle/node_modules/": "services/node_modules/",
      "../../../../Editor/services/adobe-mcp-gateway/jsx/": "services/jsx/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "startMenuFolder": "GrapiX"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
