{
  "name": "@grapix/editor",
  "version": "0.1.0",
  "private": true,
  "description": "Authoring application. Tauri 2 shell.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --build",
    "test:unit": "vitest run",
    "build:web": "esbuild web/main.ts --bundle --format=esm --target=es2022 --outfile=web/main.js --sourcemap",
    "watch:web": "esbuild web/main.ts --bundle --format=esm --target=es2022 --outfile=web/main.js --sourcemap --watch"
  },
  "dependencies": {
    "@grapix/contracts": "*",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@types/three": "0.185.0",
    "esbuild": "^0.28.2",
    "vitest": "^3"
  }
}
