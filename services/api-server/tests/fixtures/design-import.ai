<svg xmlns="http://www.w3.org/2000/svg" width="640" height="360" viewBox="0 0 640 360">
  <defs>
    <linearGradient id="heroGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0044ff" stop-opacity="1"/>
      <stop offset="55%" stop-color="#22c9aa" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="1"/>
    </linearGradient>
    <clipPath id="cardClip">
      <rect width="300" height="140"/>
    </clipPath>
  </defs>
  <g id="Hero Group" opacity="0.9">
    <rect id="Gradient Card" x="32" y="28" width="300" height="140" rx="18" fill="url(#heroGradient)" clip-path="url(#cardClip)"/>
    <path id="Open Curve" d="M 50 250 C 160 120 330 340 510 190" fill="none" stroke="#ffcc00" stroke-width="8"/>
    <text id="Headline" x="48" y="92" font-family="Inter" font-size="32" font-weight="700" fill="#ffffff">Editable headline</text>
  </g>
  <symbol id="Badge">
    <circle cx="20" cy="20" r="20" fill="#ff3366"/>
  </symbol>
</svg>
