{
  "name": "grapix",
  "private": true,
  "version": "0.2.0",
  "description": "GrapiX broadcast graphics platform: Editor, Playout and the standalone Render Engine.",
  "workspaces": [
    "Editor",
    "Editor/apps/*",
    "Editor/services/*",
    "Playout",
    "Playout/apps/*",
    "Playout/services/*",
    "Shared",
    "Shared/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @grapix/editor-workspace",
    "dev:editor": "npm run dev -w @grapix/editor-workspace",
    "dev:playout": "npm run dev -w @grapix/playout-workspace",
    "dev:engine": "cargo run --manifest-path services/render-engine/Cargo.toml -- --config services/render-engine/engine.toml",
    "dev:web": "npm run dev -w @grapix/editor-web",
    "dev:api": "npm run dev -w @grapix/api-server",
    "dev:mcp": "npm run dev -w @grapix/editor-mcp",
    "dev:electron": "npm run dev -w @grapix/desktop-electron",

    "clean:dist": "node tools/architecture/clean-dist.mjs",
    "build": "npm run clean:dist && npm run build:shared && npm run build:editor && npm run build:playout",
    "build:shared": "npm run build -w @grapix/shared-workspace",
    "build:editor": "npm run build -w @grapix/editor-workspace",
    "build:playout": "npm run build -w @grapix/playout-workspace",

    "typecheck": "npm run typecheck -w @grapix/shared-workspace && npm run typecheck -w @grapix/editor-workspace && npm run typecheck -w @grapix/playout-workspace",
    "test": "npm run test:shared && npm run test:editor && npm run test:playout",
    "test:shared": "npm run verify -w @grapix/shared-workspace",
    "test:editor": "npm run verify -w @grapix/editor-workspace",
    "test:playout": "npm run verify -w @grapix/playout-workspace",
    "test:engine": "cargo test --manifest-path services/render-engine/Cargo.toml",
    "test:core": "cargo test --manifest-path services/render-daemon/Cargo.toml",
    "check:engine": "cargo check --manifest-path services/render-engine/Cargo.toml --all-targets",
    "check:boundaries": "node tools/architecture/check-workspace-boundaries.mjs",

    "certify:engine": "node tools/certification/run-engine-e2e.mjs",
    "certify:animation": "node tools/certification/run-animation-proof.mjs",
    "certify:playout-engine": "node tools/certification/run-playout-engine-e2e.mjs",
    "certify:publish-takelist": "node tools/certification/run-publish-takelist-e2e.mjs",
    "certify:monitors": "node tools/certification/run-monitor-transport-e2e.mjs",
    "certify:take-animation": "node tools/certification/run-take-animation-e2e.mjs",
    "certify:ipc": "node tools/certification/run-ipc-e2e.mjs",
    "certify:parity": "node tools/certification/run-pixel-parity.mjs",
    "certify:materials": "npm test -w @grapix/shared-types && cargo test --manifest-path services/render-daemon/Cargo.toml --no-default-features",
    "certify:render-core": "cargo test --manifest-path services/render-daemon/Cargo.toml --test certification_project"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.4"
  }
}
